# Template. Copy to site.env and edit.
#
# This file is searched for in two places, first hit wins:
#   1. ./site.env                            (per-checkout)
#   2. $XDG_CONFIG_HOME/adsb-1090/site.env   (per-machine, survives re-clones)
#
# site.env is gitignored so coordinates never enter git history.
# Environment variables override anything set here:  GAIN=44.5 nix run .

# Position of the ANTENNA (not the house). Used for local CPR decoding,
# range rings and MLAT. South and West are negative.
LAT=-41.2865
LON=174.7762

# Tuner gain in dB. Must be a fixed value, never "auto" - see README.
# Valid: 0.0 0.9 1.4 2.7 3.7 7.7 8.7 12.5 14.4 15.7 16.6 19.7 20.7 22.9 25.4
#        28.0 29.7 32.8 33.8 36.4 37.2 38.6 40.2 42.1 43.4 43.9 44.5 48.0 49.6
GAIN=49.6

# Demodulator sensitivity, 40-400. Lower = more sensitive, more CPU.
# Leave unset to pick automatically from the host's core count.
#PREAMBLE=40

# Web UI port.
#PORT=8080

# tar1090 display units: metric | nautical | imperial.
#UNITS=metric

# Range-ring distances, comma separated, in UNITS.
#RINGS=5,10,25,50,100,150,200,250
